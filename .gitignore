# Project-local Arduino libraries (installed by tools/build.sh setup)
.arduino/

# Python bytecode from the tools/
__pycache__/
*.pyc

# Source artwork is kept; intermediate renders are not
art/*_render_*.png

# Release artefacts
dist/

# Screenshots from tools/render_screens.py. Generated from icon.h and
# TFT_eSPI's font data, so they are reproducible in seconds and would
# otherwise go stale on every UI change. The copies that are published
# live in the website repo.
render/

# Where this machine publishes releases. Read by tools/make_release.sh and
# deliberately never in the archive's include list: a path from one machine
# would otherwise be published to everyone who downloads the source.
.publish.local

# IEEE registry cache for check_oui_registry.py: 3.8 MB, not ours,
# and one command to fetch again.
tools/.oui-cache.csv

# Machine-local working notes, same reason as .publish.local above.
*.local.md

# The enclosure sources. make_release.sh has always kept these out of the
# source archive; this keeps them out of the repository too, which is the
# half that was still publishing them, since this repository is public.
# They stay on disk, editable, and the enclosure page still describes the
# design in full.
docs/pueo/*.scad
